{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:form-definition:l1:v1:candidate",
  "title": "L1 FormDefinition V1.0 – Candidate Canonical Structural Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "id",
    "version",
    "data",
    "views"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": [
            "object",
            "boolean"
          ]
        }
      },
      "additionalProperties": false
    },
    "expressions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/expression"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "reactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reaction"
      }
    },
    "views": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/viewNode"
      }
    },
    "viewTemplates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "node"
        ],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "schemaRef"
              ],
              "properties": {
                "schemaRef": {
                  "type": "string",
                  "pattern": "^#(/.*)?$"
                }
              },
              "additionalProperties": false
            }
          },
          "node": {
            "$ref": "#/$defs/viewNode"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "dataRef": {
      "type": "object",
      "required": [
        "source",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "data"
        },
        "path": {
          "type": "string",
          "pattern": "^(|/.*)$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "oneOf": [
        {
          "$ref": "#/$defs/dataRef"
        },
        {
          "type": "object",
          "required": [
            "source",
            "path"
          ],
          "properties": {
            "source": {
              "enum": [
                "context",
                "event"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^(|/.*)$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "from",
        "as"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/dataRef"
        },
        "as": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "one",
            "each"
          ]
        }
      },
      "additionalProperties": false
    },
    "scopes": {
      "oneOf": [
        {
          "$ref": "#/$defs/scope"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scope"
          }
        }
      ]
    },
    "handle": {
      "type": "object",
      "required": [
        "$scope"
      ],
      "properties": {
        "$scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "expression": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/reference"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "use"
          ],
          "properties": {
            "use": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "valueSpec": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueSpec"
          }
        },
        {
          "type": "object",
          "required": [
            "$expr"
          ],
          "properties": {
            "$expr": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$literal"
          ],
          "properties": {
            "$literal": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/valueSpec"
          },
          "propertyNames": {
            "not": {
              "enum": [
                "$expr",
                "$literal",
                "$scope"
              ]
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "required": [
        "target",
        "code"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/dataRef"
        },
        "code": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "assert",
            "issue"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "internal"
            },
            "scope": {
              "$ref": "#/$defs/scopes"
            },
            "when": {
              "$ref": "#/$defs/expression"
            },
            "assert": {
              "$ref": "#/$defs/expression"
            },
            "issue": {
              "$ref": "#/$defs/issue"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "watch",
            "target"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "external"
            },
            "scope": {
              "$ref": "#/$defs/scopes"
            },
            "when": {
              "$ref": "#/$defs/expression"
            },
            "watch": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/dataRef"
              }
            },
            "target": {
              "$ref": "#/$defs/dataRef"
            },
            "requiredForSubmit": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "target",
            "value"
          ],
          "properties": {
            "op": {
              "const": "set"
            },
            "target": {
              "$ref": "#/$defs/dataRef"
            },
            "value": {
              "$ref": "#/$defs/valueSpec"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "target",
            "value"
          ],
          "properties": {
            "op": {
              "const": "patch"
            },
            "target": {
              "$ref": "#/$defs/dataRef"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/valueSpec"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "target"
          ],
          "properties": {
            "op": {
              "const": "remove"
            },
            "target": {
              "$ref": "#/$defs/dataRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "target",
            "value"
          ],
          "properties": {
            "op": {
              "const": "array.insert"
            },
            "target": {
              "$ref": "#/$defs/dataRef"
            },
            "value": {
              "$ref": "#/$defs/valueSpec"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "target",
            "item"
          ],
          "properties": {
            "op": {
              "const": "array.remove"
            },
            "target": {
              "$ref": "#/$defs/dataRef"
            },
            "item": {
              "$ref": "#/$defs/handle"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "target",
            "item"
          ],
          "properties": {
            "op": {
              "const": "array.move"
            },
            "target": {
              "$ref": "#/$defs/dataRef"
            },
            "item": {
              "$ref": "#/$defs/handle"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "commands"
          ],
          "properties": {
            "op": {
              "const": "batch"
            },
            "commands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/command"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "reaction": {
      "type": "object",
      "required": [
        "id",
        "watch",
        "then"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scopes"
        },
        "watch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dataRef"
          }
        },
        "when": {
          "$ref": "#/$defs/expression"
        },
        "then": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      },
      "additionalProperties": false
    },
    "intent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "command"
          ],
          "properties": {
            "type": {
              "const": "form.command"
            },
            "command": {
              "$ref": "#/$defs/command"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "event"
          ],
          "properties": {
            "type": {
              "const": "host.emit"
            },
            "event": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/valueSpec"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "viewNode": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "material"
          ],
          "properties": {
            "material": {
              "type": "string",
              "minLength": 1
            },
            "props": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/valueSpec"
              }
            },
            "bindings": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/dataRef"
              }
            },
            "slots": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/viewNode"
                }
              }
            },
            "on": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/intent"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "scope",
            "node"
          ],
          "properties": {
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "node": {
              "$ref": "#/$defs/viewNode"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$use"
          ],
          "properties": {
            "$use": {
              "type": "string"
            },
            "with": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/dataRef"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
