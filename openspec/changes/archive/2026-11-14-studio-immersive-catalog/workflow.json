{
  "authority": [
    "docs/design/platform-studio.md"
  ],
  "scope": [
    "apps/studio/src/app/page.tsx",
    "apps/studio/src/app/form-editor.tsx",
    "apps/studio/src/app/config-inspection.tsx",
    "apps/studio/src/app/asset-catalog.tsx",
