      "typecheck"
    ],
    [
      "env",
      "STUDIO_DIST_DIR=.next/studio-preview",
      "PLATFORM_API_URL=http://127.0.0.1:3319",
      "pnpm",
      "--filter",
      "@form-engine/studio",
      "build"
    ],
    [
      ".venv-docs/bin/python",
      "tools/docs/build_docs.py",
      "--check"
