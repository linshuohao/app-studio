    "services/api/src/platform/catalog.controller.ts",
    "services/api/src/platform/material-previews.ts",
    "services/api/src/platform/catalog-documentation.ts",
    "services/api/test/platform-catalog-members.e2e-spec.ts",
    "tools/engineering/catalog-docs.mjs",
