{
  "authority": [
    "docs/design/platform-studio.md"
  ],
  "scope": [
    "apps/studio/src",
    "apps/studio/tests",
    "services/api/src/platform",
    "services/api/test/platform-catalog-members.e2e-spec.ts",
    "services/api/test/platform-history.e2e-spec.ts",
    "tools/engineering/catalog-docs.mjs",
    "services/api/package.json",
    "services/api/README.md"
  ],
  "checks": [
    [
      "node",
      "tools/engineering/catalog-docs.mjs",
      "--check"
    ],
    [
      "pnpm",
      "--filter",
      "@form-engine/api",
      "typecheck"
    ],
    [
      "pnpm",
      "--filter",
      "@form-engine/api",
      "build"
    ],
    [
      "pnpm",
      "--filter",
      "@form-engine/api",
      "test:integration",
      "--testTimeout=15000"
    ],
    [
      "pnpm",
      "--filter",
      "@form-engine/studio",
      "typecheck"
    ],
    [
      "env",
      "STUDIO_DIST_DIR=.next/studio-workbench",
      "PLATFORM_API_URL=http://127.0.0.1:3318",
      "pnpm",
      "--filter",
      "@form-engine/studio",
      "build"
    ],
    [
      "env",
      "STUDIO_DIST_DIR=.next/studio-workbench",
      "STUDIO_TEST_PORT=3218",
      "STUDIO_TEST_API_PORT=3318",
      "STUDIO_TEST_BROWSER_CHANNEL=chrome",
      "pnpm",
      "--dir",
      "apps/studio",
      "exec",
      "playwright",
      "test"
    ],
    [
      ".venv-docs/bin/python",
      "tools/docs/build_docs.py",
      "--check"
    ]
  ]
}
