{
  "authority": [
    "docs/design/platform-studio.md"
  ],
  "scope": [
    "services/api/src/platform",
    "services/api/test",
    "apps/studio/src",
    "apps/studio/tests",
    "apps/studio/playwright.config.ts",
    "eslint.config.mjs",
    "apps/studio/package.json",
    "apps/studio/tsconfig.json",
    "apps/studio/next.config.ts",
    "services/api/package.json",
    "services/api/tsconfig.dev.json",
    "services/api/vitest.config.e2e.ts",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "checks": [
    [
      "pnpm",
      "exec",
      "eslint",
      "services/api/src/platform",
      "services/api/test",
      "apps/studio",
      "--max-warnings",
      "0"
    ],
    [
      "pnpm",
      "--filter",
      "@form-engine/api",
      "typecheck"
    ],
    [
      "pnpm",
      "--filter",
      "@form-engine/api",
      "test:integration",
      "--testTimeout=20000",
      "--no-file-parallelism"
    ],
    [
      "pnpm",
      "--filter",
      "@form-engine/studio",
      "typecheck"
    ],
    [
      "env",
      "STUDIO_DIST_DIR=.next/admission-test",
      "STUDIO_TEST_PORT=3235",
      "STUDIO_TEST_API_PORT=3335",
      "STUDIO_TEST_BROWSER_CHANNEL=chrome",
      "pnpm",
      "--dir",
      "apps/studio",
      "exec",
      "playwright",
      "test"
    ],
    [
      ".venv-docs/bin/python",
      "tools/docs/build_docs.py",
      "--check"
    ]
  ]
}
