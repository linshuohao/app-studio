      "env",
      "STUDIO_DIST_DIR=.next/data-schema-verification",
      "PLATFORM_API_URL=http://127.0.0.1:3391",
      "STUDIO_TEST_PORT=3390",
      "STUDIO_TEST_API_PORT=3391",
      "STUDIO_TEST_BROWSER_CHANNEL=chrome",
      "pnpm",
      "exec",
      "playwright",
      "test",
      "--config",
      "apps/studio/playwright.config.ts",
      "data-schema.spec.ts",
      "schema-rules.spec.ts",
      "form-canvas.spec.ts"
