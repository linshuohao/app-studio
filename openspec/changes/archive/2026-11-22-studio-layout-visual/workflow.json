{
  "authority": [
    "docs/design/platform-studio.md"
  ],
  "scope": [
    "apps/studio/src/app/layout-bindings.ts",
    "apps/studio/src/app/layout-check.ts",
    "apps/studio/src/app/layout-editor.css",
    "apps/studio/src/app/layout-editor.tsx",
    "apps/studio/src/app/layout-keys.ts",
    "apps/studio/src/app/layout-material-value.tsx",
    "apps/studio/src/app/layout-material.tsx",
    "apps/studio/src/app/layout-structure.ts",
    "apps/studio/tests/layout-editor.spec.ts",
    "apps/studio/tests/layout-material.spec.ts",
    "apps/studio/tests/layout-structure.check.mjs",
    "apps/studio/src/app/json-source.tsx",
    "apps/studio/src/app/form-editor.tsx"
  ],
  "checks": [
    [
      "node",
      "--test",
      "apps/studio/tests/layout-structure.check.mjs"
    ],
    [
      "pnpm",
      "exec",
      "eslint",
      "apps/studio/src/app/layout-bindings.ts",
      "apps/studio/src/app/layout-check.ts",
      "apps/studio/src/app/layout-editor.tsx",
      "apps/studio/src/app/layout-keys.ts",
      "apps/studio/src/app/layout-material-value.tsx",
      "apps/studio/src/app/layout-material.tsx",
      "apps/studio/src/app/layout-structure.ts",
      "apps/studio/tests/layout-editor.spec.ts",
      "apps/studio/tests/layout-material.spec.ts",
      "apps/studio/tests/layout-structure.check.mjs",
      "apps/studio/src/app/json-source.tsx",
      "--max-warnings",
      "0"
    ],
    [
      "pnpm",
      "--filter",
      "@form-engine/studio",
      "exec",
      "tsc",
      "--noEmit",
      "--incremental",
      "false"
    ],
    [
      "env",
      "STUDIO_DIST_DIR=.next/layout-editor-verification",
      "PLATFORM_API_URL=http://127.0.0.1:3387",
      "STUDIO_TEST_PORT=3287",
      "STUDIO_TEST_API_PORT=3387",
      "STUDIO_TEST_BROWSER_CHANNEL=chrome",
      "pnpm",
      "--filter",
      "@form-engine/studio",
      "exec",
      "next",
      "build",
      "--webpack"
    ],
    [
      "env",
      "STUDIO_DIST_DIR=.next/layout-editor-verification",
      "PLATFORM_API_URL=http://127.0.0.1:3387",
      "STUDIO_TEST_PORT=3287",
      "STUDIO_TEST_API_PORT=3387",
      "STUDIO_TEST_BROWSER_CHANNEL=chrome",
      "pnpm",
      "exec",
      "playwright",
      "test",
      "--config",
      "apps/studio/playwright.config.ts",
      "layout-editor.spec.ts",
      "layout-material.spec.ts",
      "schema-navigation.spec.ts"
    ]
  ]
}
