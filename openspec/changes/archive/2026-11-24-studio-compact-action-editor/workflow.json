{
  "authority": [
    "docs/design/platform-studio.md",
    "docs/design/l1/04-command-reaction.md"
  ],
  "scope": [
    "apps/studio/src/app/reaction-action-editor.tsx",
    "apps/studio/src/app/action-editor.css",
    "apps/studio/src/app/reaction-editor.tsx",
    "apps/studio/src/app/reaction-editor.css",
    "apps/studio/src/app/reaction-model.ts",
    "apps/studio/tests/reaction-editor.spec.ts",
    "apps/studio/tests/reaction-guard.spec.ts",
    "docs/reading/platform-studio.html",
    "prototypes/studio-design-handbook.html",
    "prototypes/studio-components/business-playground.jsx",
    "prototypes/studio-components/select.html",
    "prototypes/studio-components/listfilterbar.html",
    "prototypes/studio-components/form.html",
    "prototypes/studio-components/cardlist.html",
    "prototypes/studio-components/tokens.html",
    "prototypes/studio-components/pagination.html",
    "prototypes/studio-components/textarea.html",
    "prototypes/studio-components/tabs.html",
    "prototypes/studio-components/datatable.html",
    "prototypes/studio-components/field-picker.html",
    "prototypes/studio-components/grid.html",
    "prototypes/studio-components/button.html",
    "prototypes/studio-components/menu.html",
    "prototypes/studio-components/input.html",
    "prototypes/studio-components/business.html",
    "prototypes/studio-components/expression-editor.html",
    "prototypes/studio-components/field.html",
    "prototypes/studio-components/modal.html",
    "prototypes/studio-components/griditem.html",
    "prototypes/studio-components/drawer.html",
    "prototypes/studio-components/action-editor.html",
    "prototypes/studio-components/assets/business-playground.css",
    "prototypes/studio-components/assets/business-playground.js",
    "prototypes/studio-components/assets/business-playground-runner.html"
  ],
  "checks": [
    [
      "pnpm",
      "--filter",
      "@form-engine/studio",
      "exec",
      "tsc",
      "--noEmit"
    ],
    [
      "node",
      "--test",
      "apps/studio/tests/reaction-expression.check.mjs",
      "apps/studio/tests/reaction-fields.check.mjs"
    ],
    [
      "pnpm",
      "exec",
      "eslint",
      "apps/studio/src/app/reaction-action-editor.tsx",
      "apps/studio/src/app/reaction-editor.tsx",
      "apps/studio/src/app/reaction-model.ts",
      "apps/studio/tests/reaction-editor.spec.ts",
      "apps/studio/tests/reaction-guard.spec.ts",
      "--max-warnings",
      "0"
    ],
    [
      ".venv-docs/bin/python",
      "tools/docs/build_docs.py",
      "--check"
    ],
    [
      "env",
      "STUDIO_DIST_DIR=.next/action-editor-verified",
      "PLATFORM_API_URL=http://127.0.0.1:3551",
      "pnpm",
      "--filter",
      "@form-engine/studio",
      "exec",
      "next",
      "build",
      "--webpack"
    ],
    [
      "env",
      "STUDIO_DIST_DIR=.next/action-editor-verified",
      "STUDIO_TEST_PORT=3550",
      "STUDIO_TEST_API_PORT=3551",
      "STUDIO_TEST_BROWSER_CHANNEL=chrome",
      "pnpm",
      "exec",
      "playwright",
      "test",
      "--config",
      "apps/studio/playwright.config.ts",
      "reaction-editor.spec.ts",
      "reaction-guard.spec.ts"
    ]
  ]
}
