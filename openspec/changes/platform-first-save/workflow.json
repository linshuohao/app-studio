{
  "authority": [
    "docs/design/platform-studio.md",
    "docs/design/decisions/ADR-FE-026-platform-rbac.md",
    "docs/design/decisions/ADR-FE-027-platform-modular-monolith.md",
    "docs/design/decisions/ADR-FE-029-platform-config-versions.md"
  ],
  "scope": [
    "apps/studio/.gitignore",
    "apps/studio/README.md",
    "apps/studio/next.config.ts",
    "apps/studio/package.json",
    "apps/studio/playwright.config.ts",
    "apps/studio/src",
    "apps/studio/tests",
    "apps/studio/tsconfig.json",
    "services/api/.gitignore",
    "services/api/README.md",
    "services/api/src",
    "services/api/test",
    "services/api/package.json",
    "services/api/dev-loader.mjs",
    "services/api/tsconfig.json",
    "services/api/tsconfig.build.json",
    "services/api/tsconfig.dev.json",
    "services/api/nest-cli.json",
    "services/api/vitest.config.ts",
    "services/api/vitest.config.e2e.ts",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    ".dependency-cruiser.mjs",
    "tools/config/tsconfig.boundaries.json",
    "eslint.config.mjs",
    "tools/config/eslint.mjs",
    "apps/playground/eslint.config.mjs",
    "tools/config/vitest-cache.ts"
  ],
  "checks": [
    ["pnpm", "exec", "eslint", "apps/studio", "services/api", "--max-warnings", "0"],
    [
      "pnpm",
      "exec",
      "depcruise",
      "--config",
      ".dependency-cruiser.mjs",
      "apps/studio/src",
      "services/api/src"
    ],
    ["pnpm", "--filter", "@form-engine/api", "typecheck"],
    ["pnpm", "--filter", "@form-engine/api", "build"],
    ["pnpm", "--filter", "@form-engine/api", "test:integration"],
    ["pnpm", "--filter", "@form-engine/studio", "typecheck"],
    ["pnpm", "--filter", "@form-engine/studio", "build"],
    ["pnpm", "exec", "playwright", "test", "--config", "apps/studio/playwright.config.ts"]
  ]
}
