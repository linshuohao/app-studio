  "checks": [
    [
      "pnpm",
      "exec",
      "prettier",
      "--check",
      "apps/studio/src",
      "apps/studio/tests",
      "apps/studio/package.json",
      "services/api/src/platform",
      "services/api/test",
      "services/api/package.json",
      "services/api/tsconfig.dev.json",
