      "openspec/changes/platform-history-preview/tasks.md",
      "openspec/changes/platform-history-preview/specs",
      "openspec/changes/platform-history-preview/workflow.json"
    ],
    [
      "pnpm",
      "exec",
      "turbo",
      "run",
      "build",
      "--filter=@form-engine/protocol",
      "--filter=@form-engine/compiler",
      "--filter=@form-engine/runtime",
      "--filter=@form-engine/renderer-react",
      "--filter=@form-engine/materials-react",
      "--filter=@form-engine/pure-functions"
    ],
    ["pnpm", "exec", "eslint", "apps/studio", "services/api", "--max-warnings", "0"],
    [
      "pnpm",
      "exec",
      "depcruise",
      "--config",
      ".dependency-cruiser.mjs",
      "apps/studio/src",
      "services/api/src"
    ],
    ["pnpm", "--filter", "@form-engine/api", "typecheck"],
    ["pnpm", "--filter", "@form-engine/api", "build"],
    ["pnpm", "--filter", "@form-engine/api", "test:integration"],
    ["pnpm", "--filter", "@form-engine/studio", "typecheck"],
    ["pnpm", "--filter", "@form-engine/studio", "build"],
    ["pnpm", "exec", "playwright", "test", "--config", "apps/studio/playwright.config.ts"],
    [
      "pnpm",
      "--filter",
      "@form-engine/runtime",
      "exec",
      "vitest",
      "run",
      "tests/validation.test.ts",
      "--no-cache"
    ],
    [
      "pnpm",
      "--filter",
      "@form-engine/renderer-react",
      "exec",
      "vitest",
      "run",
      "tests/requests.test.tsx",
      "--no-cache"
    ]
  ]
}
