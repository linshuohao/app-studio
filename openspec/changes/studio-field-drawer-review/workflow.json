{
  "authority": ["docs/design/platform-studio.md"],
  "scope": [
    "apps/studio/src/app/data-schema-editor.tsx",
    "apps/studio/src/app/schema-field-drawer-next.tsx",
    "apps/studio/src/app/schema-field-drawer-next.css",
    "apps/studio/src/app/schema-drawer-values.tsx",
    "apps/studio/src/app/schema-rule-inputs.tsx",
    "apps/studio/src/app/schema-rules.tsx",
    "apps/studio/tests/schema-field-drawer-next.spec.ts",
    "apps/studio/tests/data-schema.spec.ts",
    "apps/studio/tests/schema-rules.spec.ts",
    "apps/studio/tests/schema-navigation.spec.ts",
    "apps/studio/playwright.config.ts"
  ],
  "checks": [
    [
      "pnpm",
      "exec",
      "eslint",
      "apps/studio/src/app/data-schema-editor.tsx",
      "apps/studio/src/app/schema-field-drawer-next.tsx",
      "apps/studio/src/app/schema-drawer-values.tsx",
      "apps/studio/src/app/schema-rule-inputs.tsx",
      "apps/studio/src/app/schema-rules.tsx",
      "apps/studio/tests/schema-field-drawer-next.spec.ts",
      "apps/studio/tests/data-schema.spec.ts",
      "apps/studio/tests/schema-rules.spec.ts",
      "apps/studio/tests/schema-navigation.spec.ts",
      "--max-warnings",
      "0"
    ],
    [".venv-docs/bin/python", "tools/docs/build_docs.py", "--check"],
    [
      "env",
      "STUDIO_DIST_DIR=.next/field-drawer-build",
      "PLATFORM_API_URL=http://127.0.0.1:3389",
      "STUDIO_TEST_API_PORT=3389",
      "STUDIO_TEST_PORT=3388",
      "STUDIO_TEST_BROWSER_CHANNEL=chrome",
      "pnpm",
      "--dir",
      "apps/studio",
      "build"
    ],
    [
      "env",
      "STUDIO_DIST_DIR=.next/field-drawer-build",
      "PLATFORM_API_URL=http://127.0.0.1:3389",
      "STUDIO_TEST_API_PORT=3389",
      "STUDIO_TEST_PORT=3388",
      "STUDIO_TEST_BROWSER_CHANNEL=chrome",
      "pnpm",
      "--dir",
      "apps/studio",
      "exec",
      "playwright",
      "test",
      "schema-field-drawer-next.spec.ts",
      "data-schema.spec.ts",
      "schema-rules.spec.ts",
      "schema-navigation.spec.ts",
      "--grep-invert",
      "keeps module navigation visible",
      "--output",
      "/private/tmp/studio-field-drawer-build-results"
    ]
  ]
}
