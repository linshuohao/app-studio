{
  "name": "app-studio",
  "version": "1.0.0",
  "description": "Assemble Studio, an agent-first low-code workspace",
  "scripts": {
    "dev": "node tools/engineering/dev.mjs",
    "dev:all": "node tools/engineering/dev.mjs --all",
    "dev:agent": "node tools/engineering/dev.mjs --agent",
    "dev:api": "pnpm --filter @form-engine/api dev",
    "dev:recover": "node tools/engineering/dev-recover.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node tools/engineering/check-boundaries.mjs",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:integration": "vitest run && pnpm --filter @form-engine/api test:integration",
    "test:e2e": "playwright test",
    "packages:check": "node tools/engineering/check-packages.mjs",
    "handbook:build": "pnpm --filter @form-engine/studio-design-handbook build",
    "handbook:check:build": "node tools/engineering/check-studio-handbook.mjs --build-only",
    "handbook:check:tree": "node tools/engineering/check-studio-handbook.mjs",
    "docs:build": "node tools/engineering/docs.mjs",
    "docs:check": "node tools/engineering/docs.mjs --check",
    "check": "node tools/engineering/check.mjs",
    "prepare": "husky",
    "toolchain:update": "node tools/engineering/install-toolchain.mjs",
    "protocol:schema:check": "pnpm --filter @form-engine/protocol schema:check",
    "test:e2e:devtools": "playwright test --config playwright.devtools.config.ts",
    "asset:new": "node tools/engineering/assets/cli.mjs new",
    "asset:change": "node tools/engineering/assets/cli.mjs change",
    "assets:check": "node tools/engineering/assets/cli.mjs check",
    "release:plan": "node tools/engineering/assets/cli.mjs plan",
    "release:apply": "node tools/engineering/assets/cli.mjs apply",
    "release:check": "node tools/engineering/assets/cli.mjs release-check"
  },
  "keywords": [],
  "author": "",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "9.39.5",
    "@form-engine/compiler": "workspace:*",
    "@form-engine/devtools": "workspace:*",
    "@form-engine/protocol": "workspace:*",
    "@form-engine/pure-functions": "workspace:*",
    "@form-engine/runtime": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "3.35.1",
    "turbo": "^2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
