{
  "name": "@form-engine/materials-react",
  "type": "module",
  "version": "0.0.0",
  "description": "React form materials and static capability manifests",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./manifests": {
      "development": "./src/manifests.ts",
      "types": "./dist/manifests.d.ts",
      "import": "./dist/manifests.js"
    },
    "./styles.css": {
      "development": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./web-asset-compatibility": {
      "development": "./src/web-asset-compatibility.ts",
      "types": "./dist/web-asset-compatibility.d.ts",
      "import": "./dist/web-asset-compatibility.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./manifests": {
        "types": "./dist/manifests.d.ts",
        "import": "./dist/manifests.js"
      },
      "./styles.css": "./dist/styles.css",
      "./web-asset-compatibility": {
        "types": "./dist/web-asset-compatibility.d.ts",
        "import": "./dist/web-asset-compatibility.js"
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@form-engine/protocol": "workspace:*",
    "@form-engine/renderer-react": "workspace:*",
    "react-day-picker": "9.14.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
