{
  "name": "@form-engine/protocol",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical definitions, capability contracts and prepared JSON artifacts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./definition": {
      "development": "./src/definition/index.ts",
      "types": "./dist/definition/index.d.ts",
      "import": "./dist/definition/index.js"
    },
    "./capability": {
      "development": "./src/capability/index.ts",
      "types": "./dist/capability/index.d.ts",
      "import": "./dist/capability/index.js"
    },
    "./prepared": {
      "development": "./src/prepared/index.ts",
      "types": "./dist/prepared/index.d.ts",
      "import": "./dist/prepared/index.js"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./internal/json": {
      "development": "./src/internal/json.ts",
      "types": "./dist/internal/json.d.ts",
      "import": "./dist/internal/json.js"
    },
    "./internal/prepared": {
      "development": "./src/internal/prepared.ts",
      "types": "./dist/internal/prepared.d.ts",
      "import": "./dist/internal/prepared.js"
    },
    "./internal/schema": {
      "development": "./src/internal/schema.ts",
      "types": "./dist/internal/schema.d.ts",
      "import": "./dist/internal/schema.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm schema:generate && tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm schema:check && vitest run",
    "test:watch": "vitest",
    "schema:generate": "node scripts/generate-schemas.mjs",
    "schema:check": "node scripts/generate-schemas.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ts-json-schema-generator": "^2.9.0",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./definition": {
        "types": "./dist/definition/index.d.ts",
        "import": "./dist/definition/index.js"
      },
      "./capability": {
        "types": "./dist/capability/index.d.ts",
        "import": "./dist/capability/index.js"
      },
      "./prepared": {
        "types": "./dist/prepared/index.d.ts",
        "import": "./dist/prepared/index.js"
      },
      "./schemas/*.json": "./schemas/*.json",
      "./internal/json": {
        "types": "./dist/internal/json.d.ts",
        "import": "./dist/internal/json.js"
      },
      "./internal/prepared": {
        "types": "./dist/internal/prepared.d.ts",
        "import": "./dist/internal/prepared.js"
      },
      "./internal/schema": {
        "types": "./dist/internal/schema.d.ts",
        "import": "./dist/internal/schema.js"
      }
    }
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
