{
  "$defs": {
    "ArtifactIdentity": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "id": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "platform",
        "digest"
      ],
      "type": "object"
    },
    "BindingContract": {
      "additionalProperties": false,
      "description": "A static model compatibility contract, never a Runtime write permission/gate.",
      "properties": {
        "schema": {
          "$ref": "#/$defs/JsonSchema"
        }
      },
      "required": [
        "schema"
      ],
      "type": "object"
    },
    "CapabilityCatalogSnapshot": {
      "additionalProperties": false,
      "description": "Deterministically resolved input, not a registry/search API or mutable 'latest' catalog.",
      "properties": {
        "host": {
          "$ref": "#/$defs/HostContract"
        },
        "id": {
          "type": "string"
        },
        "materials": {
          "additionalProperties": {
            "$ref": "#/$defs/MaterialCatalogEntry"
          },
          "type": "object"
        },
        "pureFunctions": {
          "additionalProperties": {
            "$ref": "#/$defs/PureFunctionCatalogEntry"
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "materials",
        "pureFunctions"
      ],
      "type": "object"
    },
    "ContentDigest": {
      "description": "Digest of immutable content, including the algorithm identifier.",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "EventContract": {
      "additionalProperties": false,
      "description": "Omitted schema means a notification with no configuration-readable payload.",
      "properties": {
        "payloadSchema": {
          "$ref": "#/$defs/JsonSchema"
        }
      },
      "type": "object"
    },
    "FunctionParameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "schema": {
          "$ref": "#/$defs/JsonSchema"
        }
      },
      "required": [
        "name",
        "schema"
      ],
      "type": "object"
    },
    "HostContract": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "additionalProperties": {
            "$ref": "#/$defs/HostEventContract"
          },
          "type": "object"
        },
        "services": {
          "additionalProperties": {
            "$ref": "#/$defs/HostServiceContract"
          },
          "type": "object"
        },
        "validators": {
          "additionalProperties": {
            "$ref": "#/$defs/HostValidatorContract"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "HostEventContract": {
      "additionalProperties": false,
      "properties": {
        "optional": {
          "type": "boolean"
        },
        "payloadSchema": {
          "$ref": "#/$defs/JsonSchema"
        }
      },
      "type": "object"
    },
    "HostServiceContract": {
      "additionalProperties": false,
      "description": "Method signatures live in the actual service's own SDK.",
      "properties": {
        "contractVersion": {
          "type": "string"
        }
      },
      "required": [
        "contractVersion"
      ],
      "type": "object"
    },
    "HostServiceRequirement": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": [
        "contractVersion"
      ],
      "type": "object"
    },
    "HostValidatorContract": {
      "additionalProperties": false,
      "description": "Snapshot/Scope invocation contract version, not a named argument mapping.",
      "properties": {
        "contractVersion": {
          "type": "string"
        }
      },
      "required": [
        "contractVersion"
      ],
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonPrimitive": {
      "description": "Values that can cross the JSON protocol boundary. Missing is never serialized.",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "JsonSchema": {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/JsonObject"
        }
      ]
    },
    "MaterialCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactIdentity"
        },
        "manifest": {
          "$ref": "#/$defs/MaterialManifest"
        }
      },
      "required": [
        "manifest",
        "artifact"
      ],
      "type": "object"
    },
    "MaterialManifest": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/BindingContract"
          },
          "type": "object"
        },
        "events": {
          "additionalProperties": {
            "$ref": "#/$defs/EventContract"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "propsSchema": {
          "$ref": "#/$defs/JsonSchema"
        },
        "services": {
          "additionalProperties": {
            "$ref": "#/$defs/HostServiceRequirement"
          },
          "type": "object"
        },
        "slots": {
          "description": "Accepted slot names; no cardinality policy. Default slot is named 'default'.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "PureFunctionCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactIdentity"
        },
        "manifest": {
          "$ref": "#/$defs/PureFunctionManifest"
        }
      },
      "required": [
        "manifest",
        "artifact"
      ],
      "type": "object"
    },
    "PureFunctionManifest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/FunctionParameter"
          },
          "type": "array"
        },
        "restParameter": {
          "$ref": "#/$defs/FunctionParameter"
        },
        "returns": {
          "$ref": "#/$defs/JsonSchema"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "parameters",
        "returns"
      ],
      "type": "object"
    }
  },
  "$id": "https://form-engine.invalid/schemas/capability-catalog-snapshot.schema.json",
  "$ref": "#/$defs/CapabilityCatalogSnapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
