{
  "$defs": {
    "CallExpression": {
      "additionalProperties": false,
      "description": "同步纯计算调用，不允许 I/O、写 Data 或任意脚本。",
      "properties": {
        "args": {
          "description": "有序参数；签名及内置短路语义由 Compiler / 执行器落实。",
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "type": "array"
        },
        "op": {
          "description": "Canonical 使用确定的能力名，如 core.gte；Authoring 短名需先按白名单规范化。",
          "type": "string"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "type": "object"
    },
    "ContextReference": {
      "additionalProperties": false,
      "description": "Host 提供的只读上下文引用，不是 Command 的可写目标，也不扩展 Data-only watch。",
      "properties": {
        "path": {
          "$ref": "#/$defs/JsonPointer",
          "description": "相对 Host Context 根的 JSON Pointer。"
        },
        "source": {
          "const": "context",
          "type": "string"
        }
      },
      "required": [
        "source",
        "path"
      ],
      "type": "object"
    },
    "DataReference": {
      "additionalProperties": false,
      "description": "数据位置的声明；它不是读取结果，也不是数组成员的运行时身份。",
      "properties": {
        "path": {
          "$ref": "#/$defs/JsonPointer",
          "description": "无 scope 时相对表单数据根；有 scope 时相对该词法绑定的数据位置。"
        },
        "scope": {
          "description": "可见的词法名称，例如 insured。省略表示根数据，不隐式捕获当前数组项。",
          "type": "string"
        },
        "source": {
          "const": "data",
          "type": "string"
        }
      },
      "required": [
        "source",
        "path"
      ],
      "type": "object"
    },
    "EventReference": {
      "additionalProperties": false,
      "description": "仅在处理相应物料事件或请求时有效；不能从全局表达式或普通 Reaction 隐式取得 Payload。",
      "properties": {
        "path": {
          "$ref": "#/$defs/JsonPointer",
          "description": "相对本次 Payload 根；路径与值类型须能由对应 Event / Request 的 payloadSchema 证明。"
        },
        "source": {
          "const": "event",
          "type": "string"
        }
      },
      "required": [
        "source",
        "path"
      ],
      "type": "object"
    },
    "Expression": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "$ref": "#/$defs/ReferenceExpression"
        },
        {
          "$ref": "#/$defs/NamedExpression"
        },
        {
          "$ref": "#/$defs/CallExpression"
        },
        {
          "$ref": "#/$defs/LiteralExpression"
        }
      ],
      "description": "作者侧计算树。求值失败不等同于返回 false；可能读取集合由使用位置决定如何参与依赖。"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "允许任意业务属性名的 JSON 对象，不适用协议节点的未知字段拒绝规则。",
      "type": "object"
    },
    "JsonPointer": {
      "description": "作者侧 JSON Pointer。空串引用根值，'/' 引用空字符串属性；~0 / ~1 分别转义 ~ / /。 不使用 './age' 等额外语法；路径能否在相应数据模型上成立由 Compiler 检查。",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
      "type": "string"
    },
    "JsonPrimitive": {
      "description": "可交换的 JSON 基础值。Missing 不属于 JSON，不能以 undefined / NaN 代替。",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/JsonObject"
        }
      ],
      "description": "原样业务 JSON；其中恰好出现 $expr 等键，也不会自动成为表达式。"
    },
    "LiteralExpression": {
      "additionalProperties": false,
      "description": "AST 位置的原样 JSON 值；内部对象不再按 ref / use / op 等字段解析。",
      "properties": {
        "literal": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "literal"
      ],
      "type": "object"
    },
    "NamedExpression": {
      "additionalProperties": false,
      "description": "复用 FormDefinition.expressions 中的具名表达式；Compiler 检查引用与循环。",
      "properties": {
        "use": {
          "description": "定义内名称；被引用表达式不能隐式捕获调用者局部 Scope。",
          "type": "string"
        }
      },
      "required": [
        "use"
      ],
      "type": "object"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataReference"
        },
        {
          "$ref": "#/$defs/ContextReference"
        },
        {
          "$ref": "#/$defs/EventReference"
        },
        {
          "$ref": "#/$defs/ValidationReference"
        }
      ],
      "description": "读取来源的封闭集合。使用位置决定是否可读，写目标只接受 DataReference。"
    },
    "ReferenceExpression": {
      "additionalProperties": false,
      "description": "读取声明位置的当前值；读取本身不建立订阅。",
      "properties": {
        "ref": {
          "$ref": "#/$defs/Reference"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "ValidationObservation": {
      "description": "字段对外校验快照的观察 / 读取投影；不暴露内部任务与请求代次。",
      "enum": [
        "issues",
        "status",
        "state"
      ],
      "type": "string"
    },
    "ValidationReference": {
      "additionalProperties": false,
      "description": "只读字段校验引用，当前用于 Reaction 条件 / 动作；field 按当前词法 Scope 绑定稳定成员，不以数组下标充当成员身份。",
      "properties": {
        "field": {
          "$ref": "#/$defs/DataReference"
        },
        "observe": {
          "$ref": "#/$defs/ValidationObservation",
          "description": "issues 读取聚合问题，status 读取对外状态，state 读取完整对外快照。"
        },
        "source": {
          "const": "validation",
          "type": "string"
        }
      },
      "required": [
        "source",
        "field",
        "observe"
      ],
      "type": "object"
    }
  },
  "$id": "https://form-engine.invalid/schemas/expression.schema.json",
  "$ref": "#/$defs/Expression",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
