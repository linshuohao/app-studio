          "type": "object"
        }
      },
      "required": [
        "$use"
      ],
      "type": "object"
    },
    "ValueObject": {
      "additionalProperties": {
        "$ref": "#/$defs/ValueSpec"
      },
      "description": "属性值仍递归为 ValueSpec 的普通对象。保留键只能出现在相应的严格包装分支，不能降级为普通键。",
      "properties": {},
      "propertyNames": {
        "not": {
          "enum": [
            "$expr",
            "$literal"
          ]
        }
      },
      "type": "object"
    },
    "ValueSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "$ref": "#/$defs/ExpressionValue"
        },
        {
          "$ref": "#/$defs/LiteralValue"
        },
        {
          "items": {
            "$ref": "#/$defs/ValueSpec"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/ValueObject"
        }
      ],
      "description": "Props、Command 值及 Host Payload 的递归配置；只在这些规定位置解析，不扫描 Working Data。"
    }
  },
  "$id": "https://form-engine.invalid/schemas/prepared-form.schema.json",
  "$ref": "#/$defs/PreparedForm",
