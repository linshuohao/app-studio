{
  "$defs": {
    "AfterPosition": {
      "additionalProperties": false,
      "description": "插入 / 移动到仍属于目标数组的指定稳定成员之后。",
      "properties": {
        "item": {
          "$ref": "#/$defs/ScopeHandleReference"
        },
        "kind": {
          "const": "after",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "item"
      ],
      "type": "object"
    },
    "ArrayIndexPosition": {
      "additionalProperties": false,
      "description": "Definition 与 Prepared 语义完全相同的数字目的位置；锚点位置仍由各自领域声明。",
      "properties": {
        "index": {
          "description": "插入时为执行时数组的 0..length；移动时为移动后的最终下标 0..length-1。 Schema 检查非负整数，当前数组的实际边界由 Runtime 在执行时检查，不自动夹取或追加。",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "const": "index",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "index"
      ],
      "type": "object"
    },
    "ArrayInsertCommand": {
      "additionalProperties": false,
      "description": "在指定数组位置插入一个求值后的成员；不以 maxItems 等业务约束阻止写入。",
      "properties": {
        "op": {
          "const": "array.insert",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/ArrayPosition"
        },
        "target": {
          "$ref": "#/$defs/DataReference",
          "description": "实际值必须能执行数组操作，否则报告结构失败。"
        },
        "value": {
          "$ref": "#/$defs/ValueSpec"
        }
      },
      "required": [
        "op",
        "target",
        "position",
        "value"
      ],
      "type": "object"
    },
    "ArrayMoveCommand": {
      "additionalProperties": false,
      "description": "移动后保留成员身份；校验目的位置失败不能留下已经移除的半完成状态。",
      "properties": {
        "item": {
          "$ref": "#/$defs/ScopeHandleReference",
          "description": "被移动的成员；与 position 中的目的锚点分别解释。"
        },
        "op": {
          "const": "array.move",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/ArrayPosition"
        },
        "target": {
          "$ref": "#/$defs/DataReference"
        }
      },
      "required": [
        "op",
        "target",
        "item",
        "position"
      ],
      "type": "object"
    },
    "ArrayPosition": {
      "anyOf": [
        {
          "$ref": "#/$defs/IndexPosition"
        },
        {
          "$ref": "#/$defs/BeforePosition"
        },
        {
          "$ref": "#/$defs/AfterPosition"
        }
      ],
      "description": "执行时解析目的位置；锚点失效、越界或非整数须失败，不静默修正。"
    },
    "ArrayRemoveCommand": {
      "additionalProperties": false,
      "description": "按稳定成员身份删除；数组重排后不能误删原下标的新成员。",
      "properties": {
        "item": {
          "$ref": "#/$defs/ScopeHandleReference"
        },
        "op": {
          "const": "array.remove",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/DataReference"
        }
      },
      "required": [
        "op",
        "target",
        "item"
      ],
      "type": "object"
    },
    "ArtifactIdentity": {
      "additionalProperties": false,
      "description": "确定的实现制品身份，可被多个能力共用；下载地址不替代该身份。",
      "properties": {
        "digest": {
          "$ref": "#/$defs/ContentDigest",
          "description": "实际交付制品字节的摘要；不等同于 Manifest 的契约摘要。"
        },
        "id": {
          "description": "制品或不可变应用构建的身份，不是 Material / Pure Function 的逻辑 ID。",
          "type": "string"
        },
        "platform": {
          "description": "该实现适用的平台，由装载边界与编译目标核对。",
          "type": "string"
        }
      },
      "required": [
        "id",
        "platform",
        "digest"
      ],
      "type": "object"
    },
    "BatchCommand": {
      "additionalProperties": false,
      "description": "顺序执行且默认非原子；后续失败不回滚先前成功修改，不是通用工作流。",
      "properties": {
        "commands": {
          "description": "保留命令顺序与次数，不能仅因相同目标合并两次 insert 等显式行为。",
          "items": {
            "$ref": "#/$defs/Command"
          },
          "type": "array"
        },
        "op": {
          "const": "batch",
          "type": "string"
        }
      },
      "required": [
        "op",
        "commands"
      ],
      "type": "object"
    },
    "BeforePosition": {
      "additionalProperties": false,
      "description": "插入 / 移动到仍属于目标数组的指定稳定成员之前。",
      "properties": {
        "item": {
          "$ref": "#/$defs/ScopeHandleReference"
        },
        "kind": {
          "const": "before",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "item"
      ],
      "type": "object"
    },
    "CallExpression": {
      "additionalProperties": false,
      "description": "同步纯计算调用，不允许 I/O、写 Data 或任意脚本。",
      "properties": {
        "args": {
          "description": "有序参数；签名及内置短路语义由 Compiler / 执行器落实。",
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "type": "array"
        },
        "op": {
          "description": "Canonical 使用确定的能力名，如 core.gte；Authoring 短名需先按白名单规范化。",
          "type": "string"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "type": "object"
    },
    "CapabilityLock": {
      "additionalProperties": false,
      "description": "当前平台 / Profile 的唯一能力集合，包含确定的 core.* 实现身份。",
      "properties": {
        "materials": {
          "additionalProperties": {
            "$ref": "#/$defs/LockedCapability"
          },
          "type": "object"
        },
        "pureFunctions": {
          "additionalProperties": {
            "$ref": "#/$defs/LockedCapability"
          },
          "type": "object"
        }
      },
      "required": [
        "materials",
        "pureFunctions"
      ],
      "type": "object"
    },
    "Command": {
      "anyOf": [
        {
          "$ref": "#/$defs/SetCommand"
        },
        {
          "$ref": "#/$defs/PatchCommand"
        },
        {
          "$ref": "#/$defs/RemoveCommand"
        },
        {
          "$ref": "#/$defs/ArrayInsertCommand"
        },
        {
          "$ref": "#/$defs/ArrayRemoveCommand"
        },
        {
          "$ref": "#/$defs/ArrayMoveCommand"
        },
        {
          "$ref": "#/$defs/BatchCommand"
        }
      ],
      "description": "作者侧七类受控数据修改语言。网络 / 提交 / UI 动画由 Host 或物料负责。"
    },
    "CommandIntent": {
      "additionalProperties": false,
      "description": "在物料事件发生时执行数据命令，不因命令值读取变化而自动触发。",
      "properties": {
        "command": {
          "$ref": "#/$defs/Command"
        },
        "type": {
          "const": "form.command",
          "type": "string"
        }
      },
      "required": [
        "type",
        "command"
      ],
      "type": "object"
    },
    "ConstraintPrerequisite": {
      "additionalProperties": false,
      "description": "指定同步 Constraint 的本轮通过结论；External 目标、环和自包含由 Compiler 拒绝。",
      "properties": {
        "constraintId": {
          "description": "声明 ID，由 Compiler 解析到唯一可绑定的 Scope 规则实例模式。",
          "type": "string"
        },
        "kind": {
          "const": "constraint",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "constraintId"
      ],
      "type": "object"
    },
    "ContentDigest": {
      "description": "含算法前缀的不可变内容摘要。十六进制长度由生成的 Schema 检查，TS 模板类型只约束前缀。",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "ContextReference": {
      "additionalProperties": false,
      "description": "Host 提供的只读上下文引用，不是 Command 的可写目标，也不扩展 Data-only watch。",
      "properties": {
        "path": {
          "$ref": "#/$defs/JsonPointer",
          "description": "相对 Host Context 根的 JSON Pointer。"
        },
        "source": {
          "const": "context",
          "type": "string"
        }
      },
      "required": [
        "source",
        "path"
      ],
      "type": "object"
    },
    "DataReference": {
      "additionalProperties": false,
      "description": "数据位置的声明；它不是读取结果，也不是数组成员的运行时身份。",
      "properties": {
        "path": {
          "$ref": "#/$defs/JsonPointer",
          "description": "无 scope 时相对表单数据根；有 scope 时相对该词法绑定的数据位置。"
        },
        "scope": {
          "description": "可见的词法名称，例如 insured。省略表示根数据，不隐式捕获当前数组项。",
          "type": "string"
        },
        "source": {
          "const": "data",
          "type": "string"
        }
      },
      "required": [
        "source",
        "path"
      ],
      "type": "object"
    },
    "DataWatch": {
      "additionalProperties": false,
      "description": "规则和完整呈现表达式共用的静态观察项；不是已激活订阅。 省略 aspect 等同 value，structure 只表示同一 Data 的集合结构观察。 不新增 Context / Event / 校验状态等 L1 Watch 来源。",
      "properties": {
        "aspect": {
          "enum": [
            "value",
            "structure"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/JsonPointer",
          "description": "无 scope 时相对表单数据根；有 scope 时相对该词法绑定的数据位置。"
        },
        "scope": {
          "description": "可见的词法名称，例如 insured。省略表示根数据，不隐式捕获当前数组项。",
          "type": "string"
        },
        "source": {
          "const": "data",
          "type": "string"
        }
      },
      "required": [
        "path",
        "source"
      ],
      "type": "object"
    },
    "EventReference": {
      "additionalProperties": false,
      "description": "仅在处理相应物料事件或请求时有效；不能从全局表达式或普通 Reaction 隐式取得 Payload。",
      "properties": {
        "path": {
          "$ref": "#/$defs/JsonPointer",
          "description": "相对本次 Payload 根；路径与值类型须能由对应 Event / Request 的 payloadSchema 证明。"
        },
        "source": {
          "const": "event",
          "type": "string"
        }
      },
      "required": [
        "source",
        "path"
      ],
      "type": "object"
    },
    "Expression": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "$ref": "#/$defs/ReferenceExpression"
        },
        {
          "$ref": "#/$defs/NamedExpression"
        },
        {
          "$ref": "#/$defs/CallExpression"
        },
        {
          "$ref": "#/$defs/LiteralExpression"
        }
      ],
      "description": "作者侧计算树。求值失败不等同于返回 false；可能读取集合由使用位置决定如何参与依赖。"
    },
    "ExpressionValue": {
      "additionalProperties": false,
      "description": "在递归 ValueSpec 中显式进入表达式语法；不能和其他对象字段混用。",
      "properties": {
        "$expr": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": [
        "$expr"
      ],
      "type": "object"
    },
    "HostEventIntent": {
      "additionalProperties": false,
      "description": "将业务意图交给 Host；不描述网络或等待 Host 返回值的编排。",
      "properties": {
        "event": {
          "description": "Host 业务事件名称，区别于 MaterialNode.on 字典中的物料事件名称。",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ValueSpec",
          "description": "事件发生时求值；可读取当次允许的 Event Reference。"
        },
        "type": {
          "const": "host.emit",
          "type": "string"
        }
      },
      "required": [
        "type",
        "event"
      ],
      "type": "object"
    },
    "HostEventRequirement": {
      "additionalProperties": false,
      "description": "已编译出的 Host 业务事件需求，不是物料内部事件列表。",
      "properties": {
        "contractVersion": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "optional": {
          "description": "编译后显式记录是否允许缺失；必要业务操作的降级由 Host 决定。",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "optional"
      ],
      "type": "object"
    },
    "HostRequestRequirement": {
      "additionalProperties": false,
      "description": "按 Host 请求名称聚合的需求；具体输入输出契约保留在各节点映射中。",
      "properties": {
        "name": {
          "type": "string"
        },
        "nodeIds": {
          "description": "引用该能力的静态 PreparedMaterialNode id，不是运行时挂载实例 ID。",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "nodeIds"
      ],
      "type": "object"
    },
    "HostRequirements": {
      "additionalProperties": false,
      "description": "装载 / 调用时核对的 Host 能力摘要，不包含注册函数、请求策略或 cancel 句柄。",
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/HostEventRequirement"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/HostRequestRequirement"
          },
          "type": "array"
        },
        "validators": {
          "items": {
            "$ref": "#/$defs/HostValidatorRequirement"
          },
          "type": "array"
        }
      },
      "required": [
        "validators",
        "events",
        "requests"
      ],
      "type": "object"
    },
    "HostValidatorRequirement": {
      "additionalProperties": false,
      "description": "静态校验能力需求；适用 Validator 缺失必须视为未完成，不能 optional 放行。",
      "properties": {
        "constraintIds": {
          "description": "引用同一能力的规则来源，实例和任务仍彼此独立。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contractVersion": {
          "description": "有 Host 静态契约时记录；省略不意味着实现存在或兼容性已被证明。",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "constraintIds"
      ],
      "type": "object"
    },
    "IndexPosition": {
      "$ref": "#/$defs/ArrayIndexPosition",
      "description": "作者侧数字目的位置，复用与 Prepared 完全相同的下标语义和生成约束。"
    },
    "InteractionIntent": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommandIntent"
        },
        {
          "$ref": "#/$defs/HostEventIntent"
        }
      ],
      "description": "对配置开放的两类事件响应；物料内部 Binding 写入不必重复映射成 on.change。"
    },
    "IssueDefinition": {
      "additionalProperties": false,
      "description": "内部业务断言失败时产生的 Issue 声明，不在此存放当前校验结果。",
      "properties": {
        "code": {
          "description": "稳定业务错误码，独立于展示语言和执行异常诊断。",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/MessageSpec",
          "description": "专属文案覆盖；省略时由默认消息体系处理。"
        },
        "target": {
          "$ref": "#/$defs/DataReference",
          "description": "错误归属位置；该目标本身不自动成为规则的读取依赖。"
        }
      },
      "required": [
        "target",
        "code"
      ],
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "允许任意业务属性名的 JSON 对象，不适用协议节点的未知字段拒绝规则。",
      "type": "object"
    },
    "JsonPointer": {
      "description": "作者侧 JSON Pointer。空串引用根值，'/' 引用空字符串属性；~0 / ~1 分别转义 ~ / /。 不使用 './age' 等额外语法；路径能否在相应数据模型上成立由 Compiler 检查。",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
      "type": "string"
    },
    "JsonPrimitive": {
      "description": "可交换的 JSON 基础值。Missing 不属于 JSON，不能以 undefined / NaN 代替。",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "JsonSchema": {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/JsonObject"
        }
      ],
      "description": "原样业务 JSON；其中恰好出现 $expr 等键，也不会自动成为表达式。"
    },
    "LiteralExpression": {
      "additionalProperties": false,
      "description": "AST 位置的原样 JSON 值；内部对象不再按 ref / use / op 等字段解析。",
      "properties": {
        "literal": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "literal"
      ],
      "type": "object"
    },
    "LiteralValue": {
      "additionalProperties": false,
      "description": "ValueSpec 位置的原样 JSON 包装；内部不递归解释，允许存放含保留键的真实业务数据。",
      "properties": {
        "$literal": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "$literal"
      ],
      "type": "object"
    },
    "LockedCapability": {
      "additionalProperties": false,
      "description": "Compiler 使用的契约与 Runtime 实际装配的制品分别锁定，不按 latest 重新解析。",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactIdentity",
          "description": "同一制品可提供多个能力；装载核对不能仅比较版本字符串。"
        },
        "id": {
          "type": "string"
        },
        "manifestDigest": {
          "$ref": "#/$defs/ContentDigest",
          "description": "确定性序列化的 Manifest 内容摘要，与实现制品字节摘要区分。"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "manifestDigest",
        "artifact"
      ],
      "type": "object"
    },
    "MessageSpec": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            }
          },
          "required": [
            "key"
          ],
          "type": "object"
        }
      ],
      "description": "展示文案或由 Host 解析的资源键；消息缺失不能吞掉错误，消息覆盖不能改变校验结论。"
    },
    "NamedExpression": {
      "additionalProperties": false,
      "description": "复用 FormDefinition.expressions 中的具名表达式；Compiler 检查引用与循环。",
      "properties": {
        "use": {
          "description": "定义内名称；被引用表达式不能隐式捕获调用者局部 Scope。",
          "type": "string"
        }
      },
      "required": [
        "use"
      ],
      "type": "object"
    },
    "PatchCommand": {
      "additionalProperties": false,
      "description": "浅层更新对象字段，不递归深合并。",
      "properties": {
        "op": {
          "const": "patch",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/DataReference"
        },
        "value": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueSpec"
          },
          "description": "待写字段字典，键为业务字段名，各值按 ValueSpec 求值。",
          "type": "object"
        }
      },
      "required": [
        "op",
        "target",
        "value"
      ],
      "type": "object"
    },
    "PreparedBuild": {
      "additionalProperties": false,
      "description": "构建追踪信息；不重复 Definition 身份，也不替代各能力的实际目标平台。",
      "properties": {
        "catalogSnapshotId": {
          "type": "string"
        },
        "compilerVersion": {
