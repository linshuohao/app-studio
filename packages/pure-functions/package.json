{
  "name": "@form-engine/pure-functions",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Synchronous core functions and their catalog contracts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./manifests": {
      "development": "./src/manifests.ts",
      "types": "./dist/manifests.d.ts",
      "import": "./dist/manifests.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./manifests": {
        "types": "./dist/manifests.d.ts",
        "import": "./dist/manifests.js"
      }
    }
  },
  "dependencies": {
    "@form-engine/protocol": "workspace:*"
  }
}
