{
  "name": "@form-engine/runtime",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Prepared form data, reaction and validation runtime",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./devtools": {
      "development": "./src/devtools/index.ts",
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.development.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@form-engine/protocol": "workspace:*",
    "@form-engine/pure-functions": "workspace:*",
    "@noble/hashes": "1.8.0",
    "ajv": "8.20.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "development": "./dist/development/index.js",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./devtools": {
        "development": "./dist/development/devtools/index.js",
        "types": "./dist/devtools/index.d.ts",
        "import": "./dist/devtools/index.js"
      }
    }
  }
}
