{
  "protocolVersion": "1.0",
  "id": "field-validation",
  "version": "1.0",
  "data": {
    "schema": {
      "type": "object",
      "properties": {
        "contactName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": ["contactName"]
    }
  },
  "views": {
    "default": {
      "material": "section",
      "props": {
        "title": "旅险目的地登记"
      },
      "children": [
        {
          "material": "field",
          "props": {
            "label": "联系人姓名"
          },
          "bind": "/contactName",
          "children": [
            {
              "material": "text-input",
              "bind": "/contactName"
            }
          ]
        }
      ]
    }
  }
}
