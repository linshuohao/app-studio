{
  "protocolVersion": "1.0",
  "id": "task-assignment",
  "version": "1.0",
  "data": {
    "schema": {
      "type": "object",
      "properties": {
        "taskNo": {
          "type": "string",
          "minLength": 1,
          "pattern": "^RC[0-9]{8}$"
        },
        "assignee": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["id", "label"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "string",
          "enum": ["normal", "urgent"],
          "default": "normal"
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        }
      },
      "required": ["taskNo", "assignee", "priority"],
      "additionalProperties": false,
      "not": {
        "required": ["assignee"],
        "properties": {
          "assignee": {
            "type": "null"
          }
        }
      }
    }
  },
  "views": {
    "default": {
      "material": "section",
      "props": {
        "title": "门店回访任务派单"
      },
      "children": [
        {
          "material": "field",
          "props": {
            "label": "任务号"
          },
          "bindings": {
            "value": {
              "source": "data",
              "path": "/taskNo"
            }
          },
          "children": [
            {
              "material": "text-input",
              "bindings": {
                "value": {
                  "source": "data",
                  "path": "/taskNo"
                }
              }
            }
          ]
        },
        {
          "material": "field",
          "props": {
            "label": "承接顾问"
          },
          "bind": "/assignee",
          "children": [
            {
              "material": "remote-select",
              "bind": "/assignee",
              "props": {},
              "requests": {
                "search": {
                  "type": "host.request",
                  "request": "travel.searchStaff"
                }
              }
            }
          ]
        },
        {
          "material": "field",
          "props": {
            "label": "优先级"
          },
          "bindings": {
            "value": {
              "source": "data",
              "path": "/priority"
            }
          },
          "children": [
            {
              "material": "select",
              "bindings": {
                "value": {
                  "source": "data",
                  "path": "/priority"
                }
              },
              "props": {
                "options": [
                  {
                    "id": "normal",
                    "label": "普通"
                  },
                  {
                    "id": "urgent",
                    "label": "紧急"
                  }
                ]
              }
            }
          ]
        },
        {
          "material": "field",
          "props": {
            "label": "交接说明"
          },
          "bindings": {
            "value": {
              "source": "data",
              "path": "/note"
            }
          },
          "children": [
            {
              "material": "text-input",
              "bindings": {
                "value": {
                  "source": "data",
                  "path": "/note"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "metadata": {
    "hostIntegration": {
      "initialData": {
        "priority": "normal"
      },
      "requests": {
        "travel.searchStaff": {
          "input": {
            "query": "搜索词",
            "filterKey": "筛选编码或 null"
          },
          "output": {
            "items": [
              {
                "id": "选项编码",
                "label": "显示内容"
              }
            ]
          },
          "behavior": "按当前门店和身份查询在岗员工。id 是员工编号，label 拼接姓名与工号。"
        }
      },
      "delivery": {
        "taskNo": "/taskNo",
        "assigneeId": "/assignee/id",
        "priority": "/priority",
        "note": "/note"
      }
    }
  }
}
