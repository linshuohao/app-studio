      }
    },
    {
      "id": "grant-batch-rules",
      "kind": "external",
      "validator": "business.validateGrantApplications",
      "target": {
        "source": "data",
        "path": "/budgetMinor"
      },
      "watch": [
        {
          "source": "data",
          "path": "/budgetMinor"
        },
        {
          "source": "data",
          "path": "/applications"
        }
      ]
    }
  ],
  "reactions": [
    {
      "id": "clear-housing-residenceCode",
      "watch": [
        {
          "source": "data",
          "path": "/kind",
          "scope": "person"
        }
      ],
      "then": [
        {
          "op": "remove",
          "target": {
            "source": "data",
            "path": "/residenceCode",
            "scope": "person"
          }
        }
      ],
      "runOnActivate": false,
      "when": {
        "op": "core.and",
        "args": [
          {
            "op": "core.exists",
            "args": [
              {
                "ref": {
                  "source": "data",
                  "path": "/residenceCode",
                  "scope": "person"
                }
              }
            ]
          },
          {
            "op": "core.not",
            "args": [
              {
                "op": "core.and",
                "args": [
                  {
                    "op": "core.exists",
                    "args": [
                      {
                        "ref": {
                          "source": "data",
                          "path": "/kind",
                          "scope": "person"
                        }
                      }
                    ]
                  },
                  {
                    "op": "core.eq",
                    "args": [
                      {
                        "ref": {
                          "source": "data",
                          "path": "/kind",
                          "scope": "person"
                        }
                      },
                      "boarding"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "scope": {
        "from": {
          "source": "data",
          "path": "/applications"
        },
        "mode": "each",
        "as": "person"
      }
    },
    {
      "id": "clear-grant-appeal",
      "watch": [
        {
          "source": "data",
          "path": "/requestedMinor",
          "scope": "person"
        }
      ],
      "then": [
        {
          "op": "remove",
          "target": {
            "source": "data",
            "path": "/appealReason",
            "scope": "person"
          }
        }
      ],
