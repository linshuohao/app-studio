      "kind": "internal",
      "assert": {
        "op": "core.exists",
        "args": [
          {
            "ref": {
              "source": "data",
              "path": "/appealReason",
              "scope": "person"
            }
          }
        ]
      },
      "issue": {
        "target": {
          "source": "data",
          "path": "/appealReason",
          "scope": "person"
        },
        "code": "large-grant-explanation",
        "message": {
          "text": "大额申请须填复核说明"
        }
      },
      "when": {
        "op": "core.and",
        "args": [
          {
            "op": "core.exists",
            "args": [
              {
                "ref": {
                  "source": "data",
                  "path": "/requestedMinor",
                  "scope": "person"
                }
              }
            ]
          },
          {
            "op": "core.gt",
