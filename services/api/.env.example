API_PORT=3001
HOST=127.0.0.1
# Inject a service-only PostgreSQL URL before starting; never expose it via NEXT_PUBLIC_*.
PLATFORM_DATABASE_URL=postgresql://platform_app:replace-me@127.0.0.1:55432/platform_db
# Deployment migration / import uses a separate owner credential.
# PLATFORM_MIGRATION_DATABASE_URL=postgresql://platform_migrator:replace-me@127.0.0.1:55432/platform_db
# Tests only: administrator of a disposable PostgreSQL instance.
# PLATFORM_TEST_DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:55432/postgres
