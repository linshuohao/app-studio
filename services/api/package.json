{
  "name": "@form-engine/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm catalog:check && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file-if-exists=.env.local node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "pnpm dev",
    "start:debug": "node --env-file-if-exists=.env.local --watch --inspect --import ./dev-loader.mjs src/main.ts",
    "start:prod": "node --env-file-if-exists=.env.local dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "node --env-file-if-exists=.env.local --watch --import ./dev-loader.mjs src/main.ts",
    "typecheck": "tsc --project tsconfig.dev.json --noEmit",
    "test:integration": "vitest run --config ./vitest.config.e2e.ts",
    "catalog:generate": "node ../../tools/engineering/catalog-docs.mjs",
    "catalog:check": "node ../../tools/engineering/check-catalog-examples.mjs",
    "db:migrate": "node --env-file-if-exists=.env.migration.local tools/migrate.mjs",
    "db:import-sqlite": "node --env-file-if-exists=.env.migration.local tools/import-sqlite.mjs",
    "db:up": "docker compose --env-file .env.postgres.local -f compose.postgres.yaml up -d --wait",
    "db:stop": "docker compose --env-file .env.postgres.local -f compose.postgres.yaml stop"
  },
  "dependencies": {
    "@form-engine/compiler": "workspace:*",
    "@form-engine/materials-react": "workspace:*",
    "@form-engine/pure-functions": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.5.1",
    "ai": "^7.0.179",
    "jsonc-parser": "3.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
