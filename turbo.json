{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tools/config/**",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "pnpm-workspace.yaml",
    "tools/engineering/**",
    ".node-version"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "schemas/**"],
      "env": ["API_PORT", "HOST", "NEXT_PUBLIC_API_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "API_PORT", "HOST"]
    },
    "lint": {
      "dependsOn": ["source"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["source"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tests/fixtures/**"]
    },
    "test": {
      "dependsOn": ["source"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tests/fixtures/**"]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false
    },
    "source": {
      "dependsOn": ["^source"]
    }
  }
}
